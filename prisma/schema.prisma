generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  VERIFIED
  CANCELLED
}

enum RefSource {
  MAPLE
  IGP_BOOK
}

model Category {
  id   Int    @id @default(autoincrement()) @map("id") @db.SmallInt
  name String @unique @map("name") @db.VarChar(50)

  emoji       String? @map("emoji") @db.VarChar(20) // Emojis can have long unicode sequences
  code        String  @unique @map("code") @db.VarChar(20)
  description String? @map("description") @db.Text

  departmentId Int?        @map("department_id") @db.SmallInt
  department   Department? @relation(fields: [departmentId], references: [id])

  items Item[]

  @@map("categories")
}

model Department {
  id          Int     @id @default(autoincrement()) @map("id") @db.SmallInt
  name        String  @unique @map("name") @db.VarChar(50)
  code        String  @unique @map("code") @db.VarChar(10)
  description String? @map("description") @db.Text

  headId Int?      @unique @map("head_id") @db.SmallInt
  head   Employee? @relation("DepartmentHead", fields: [headId], references: [id])

  employees  Employee[] @relation("DepartmentMembers")
  categories Category[]

  @@map("departments")
}

model Employee {
  id         Int    @id @default(autoincrement()) @map("id")
  fullName   String @map("full_name") @db.VarChar(100)
  employeeId String @unique @map("employee_id") @db.VarChar(20)
  email      String @unique @map("email") @db.VarChar(255)

  designation String @map("designation") @db.VarChar(100)

  departmentId Int?        @map("department_id") @db.SmallInt
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])

  managedDept Department? @relation("DepartmentHead")
  issuances   Issuance[]

  @@map("employees")
}

model Supplier {
  id        Int        @id @default(autoincrement()) @map("id")
  name      String     @unique @map("name") @db.VarChar(100)
  purchases Purchase[]

  @@map("suppliers")
}

model Uom {
  id   Int    @id @default(autoincrement()) @db.SmallInt
  name String @unique @db.VarChar(50) // e.g., "Kilograms"

  items Item[]

  @@map("uoms")
}

model Item {
  id Int @id @default(autoincrement())

  sku         String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  uomId Int @map("uom_id") @db.SmallInt
  uom   Uom @relation(fields: [uomId], references: [id])

  minThreshold Int @default(0) @map("min_threshold") // For your custom alerts

  categoryId Int?      @map("category_id") @db.SmallInt
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at") // Powers the "Last Modified" column

  purchaseItems PurchaseItem[]
  issuances     Issuance[]
  issuanceItems IssuanceItem[]

  @@map("items")
}

model Purchase {
  id           Int               @id @default(autoincrement()) @map("id")
  status       TransactionStatus @default(PENDING)
  purchaseDate DateTime          @map("purchase_date") @db.Date

  supplierId Int      @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  sourceType  RefSource @map("source_type")
  referenceNo String    @map("reference_no") @db.VarChar(50)

  // RELATION: A purchase now has multiple line items
  items PurchaseItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("purchases")
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  // Link to the parent Purchase
  purchaseId Int      @map("purchase_id")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  // Link to the specific Item
  itemId Int  @map("item_id")
  item   Item @relation(fields: [itemId], references: [id])

  quantity Decimal  @db.Decimal(12, 2)
  rate     Decimal? @db.Decimal(12, 2)

  @@map("purchase_items")
}

model Issuance {
  id           Int      @id @default(autoincrement()) @map("id")
  issuanceDate DateTime @default(now()) @map("issuance_date") @db.Date

  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  sourceType  RefSource @map("source_type")
  referenceNo String    @unique @map("reference_no") @db.VarChar(50) // Unique ticket ID

  remarks  String? @map("remarks") @db.Text
  postedBy String? @map("posted_by") @db.VarChar(100)

  // The line items
  items IssuanceItem[]

  createdAt DateTime @default(now()) @map("created_at")
  item      Item?    @relation(fields: [itemId], references: [id])
  itemId    Int?

  @@map("issuances")
}

model IssuanceItem {
  id Int @id @default(autoincrement())

  issuanceId Int      @map("issuance_id")
  issuance   Issuance @relation(fields: [issuanceId], references: [id], onDelete: Cascade)

  itemId Int  @map("item_id")
  item   Item @relation(fields: [itemId], references: [id])

  quantity Decimal @db.Decimal(12, 2)

  @@map("issuance_items")
}

view InventorySummary {
  item_id          Int      @unique
  item_sku         String   @unique
  item_name        String
  group_item       String?
  description      String
  uom              String
  min_threshold    Int
  total_purchased  Decimal?
  total_issued     Decimal?
  current_balance  Decimal?
  inventory_status String
  last_modified    DateTime

  @@map("v_inventory_summary")
}
